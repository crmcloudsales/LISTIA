{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "listia-app",
  "main": "listia-app-worker/index.js",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
}
// Worker-first is required so LISTIA tenant subdomains, health routes and Marketplace APIs are handled before SPA static fallback.
