/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  Origin-Agent-Cluster: ?1
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(self), usb=(), bluetooth=(), serial=(), hid=(), clipboard-read=(), clipboard-write=(self), fullscreen=(self)
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self'; script-src 'self' https://js.stripe.com https://*.js.stripe.com https://checkout.stripe.com; connect-src 'self' https://*.supabase.co https://api.stripe.com https://checkout.stripe.com https://link.com https://*.link.com; frame-src https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://checkout.stripe.com https://link.com https://*.link.com https://www.openstreetmap.org https://maps.google.com https://www.google.com; worker-src 'self'; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests;
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex

/*.js
  Cache-Control: no-store, max-age=0

/*.css
  Cache-Control: no-store, max-age=0

/*.html
  Cache-Control: no-store, max-age=0

/index.html
  Cache-Control: no-store, max-age=0, must-revalidate

/config.js
  Cache-Control: no-store, max-age=0, must-revalidate

/sw.js
  Cache-Control: no-store, max-age=0, must-revalidate
  Service-Worker-Allowed: /

/*.webmanifest
  Cache-Control: no-store, max-age=0, must-revalidate

/listia-isotipo-*-v2.png
  Cache-Control: public, max-age=31536000, immutable

/listia-app-icon-*.png
  Cache-Control: public, max-age=31536000, immutable
