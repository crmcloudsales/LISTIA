/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://static.tokkobroker.com https://*.stripe.com https://*.link.com; style-src 'self'; script-src 'self' https://js.stripe.com https://*.js.stripe.com https://checkout.stripe.com; connect-src 'self' https://*.supabase.co https://api.stripe.com https://checkout.stripe.com https://link.com https://*.link.com; frame-src https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://checkout.stripe.com https://link.com https://*.link.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self';
  X-Robots-Tag: noindex, nofollow

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/app.js
  Cache-Control: no-cache

/billing.js
  Cache-Control: no-cache, no-store, must-revalidate

/billing.css
  Cache-Control: no-cache, no-store, must-revalidate

/install.js
  Cache-Control: no-cache, no-store, must-revalidate

/config.js
  Cache-Control: no-cache, no-store, must-revalidate

/listia-voice.js
  Cache-Control: no-cache, no-store, must-revalidate

/marketplace-feed-enhancements.js
  Cache-Control: no-cache, no-store, must-revalidate

/marketplace-feed.css
  Cache-Control: no-cache, no-store, must-revalidate

/readability.css
  Cache-Control: no-cache, no-store, must-revalidate

/styles.css
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/*.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

/listia-isotipo-*-v2.png
  Cache-Control: public, max-age=31536000, immutable

/listia-app-icon-*.png
  Cache-Control: no-cache, no-store, must-revalidate

/listia-app-icon-official.jpg
  Cache-Control: no-cache, no-store, must-revalidate
